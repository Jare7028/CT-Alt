# Independent CT Alt Supabase project only. Never use another app's project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# No service-role key is used by the application.

# Optional private Knowledge Base files verifier, server only; never prefix NEXT_PUBLIC_.
# Files return unavailable until this distinct HMAC key matches the private DB key.
# KEY_ID: 1-32 ASCII letters, digits, underscore or hyphen. KEY: base64 of >=32 random bytes.
# Leave blank for installations without private file schema/configuration.
CT_ALT_KB_FILE_HMAC_KEY_ID=
CT_ALT_KB_FILE_HMAC_KEY=

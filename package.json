{
  "name": "ct-alt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5180",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 5180",
    "test:shell": "node scripts/review-shell.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test:db": "node scripts/test-database.mjs",
    "test:rotas:db": "node scripts/test-rotas-database.mjs",
    "test:local:setup": "node scripts/setup-local-tests.mjs",
    "test:browser": "playwright test",
    "test:config": "node --test tests/config/*.test.mjs",
    "test:controls": "node scripts/review-directory-controls.mjs",
    "test:overview:db": "node scripts/test-overview-snapshot-database.mjs",
    "test:time-clock:db": "node scripts/test-time-clock-database.mjs",
    "test:team-timesheets:db": "node scripts/test-team-timesheets-database.mjs",
    "test:quick-tasks:db": "node scripts/test-quick-tasks-database.mjs",
    "test:chat-search:db": "node scripts/test-chat-search-database.mjs",
    "test:time-off:db": "node scripts/test-time-off-database.mjs",
    "test:updates:db": "node scripts/test-updates-database.mjs",
    "test:updates-export:db": "node scripts/test-updates-export-database.mjs",
    "test:smart-groups:db": "node scripts/test-smart-groups-database.mjs",
    "test:knowledge-base:db": "node scripts/test-knowledge-base-database.mjs",
    "test:forms:db": "node scripts/test-forms-database.mjs",
    "test:forms-reporting:db": "node scripts/test-forms-reporting-database.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "typescript": "5.9.3"
  }
}
